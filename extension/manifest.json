{
  "manifest_version": 3,
  "name": "AAPC Purchases Explorer & Downloader",
  "version": "1.0.0",
  "description": "Fetch, inspect, and download AAPC purchases with full order details, live search, and CSV export directly on AAPC.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.aapc.com/*",
    "*://*.b2clogin.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AAPC Purchases Web App",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aapc.com/*",
        "*://*.b2clogin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
